@page "/Error"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.Diagnostics

@inject IStringLocalizer<CommonResource> CommonLoc

@* The host's exception handler re-executes here outside Development. Static on
   purpose: the request has already failed once, so the page must not depend on a
   circuit, and MainLayout renders its static chrome (a Sign out link, no dead
   menus). *@

<PageTitle>@CommonLoc["Error_PageTitle"] - @CommonLoc["AppName"]</PageTitle>

<StatusPanel Icon="@Icons.Material.Filled.ErrorOutline" IconColor="Color.Error" Title="@CommonLoc["Error_Heading"]">
    <ChildContent>
        <MudText Typo="Typo.body1" Align="Align.Center">@CommonLoc["Error_Description"]</MudText>
        @if (ShowRequestId)
        {
            <MudText Typo="Typo.body2" Align="Align.Center">
                @CommonLoc["Error_RequestId"] <code>@RequestId</code>
            </MudText>
        }
    </ChildContent>
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">
            @CommonLoc["Btn_GoHome"]
        </MudButton>
    </Actions>
</StatusPanel>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
