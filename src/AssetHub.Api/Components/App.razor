<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />  
    <link href="_content/AssetHub.Ui/css/fonts.css" rel="stylesheet" />
    <link href=@Assets["_content/MudBlazor/MudBlazor.min.css"] rel="stylesheet" />
    <link href="css/app.css" rel="stylesheet" />
    <ImportMap />
    <link rel="icon" type="image/ico" href="favicon.ico" />
    <HeadOutlet @rendermode="@PageRenderMode" />
</head>

<body>
    <Routes @rendermode="@PageRenderMode" />
    <script src="_framework/blazor.web.js"></script>
    <script src=@Assets["_content/MudBlazor/MudBlazor.min.js"]></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Pages marked [ExcludeFromInteractiveRouting] render statically: no circuit,
    // so no hydration, so nothing can discard what the user already typed. The auth
    // forms need that — they are plain POSTs that establish a cookie, which an
    // interactive circuit cannot do, so interactivity was pure cost there.
    //
    // HeadOutlet takes the SAME mode as Routes on purpose; mismatching them makes
    // the head and body disagree about whether the page is interactive.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext?.AcceptsInteractiveRouting() is true ? InteractiveServer : null;
}
