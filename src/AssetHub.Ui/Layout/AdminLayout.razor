@inherits LayoutComponentBase
@layout MainLayout
@using AssetHub.Ui.Resources
@inject IStringLocalizer<AdminResource> AdminLoc

@* Admin console shell: a grouped secondary nav (Access / Content / Operations)
   beside the active admin page. Each admin function is its own route
   (/admin/...), so it deep-links, breadcrumbs and back-buttons work, and the
   secondary nav highlights the active area. Replaces the former 14-tab monolith. *@
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Start" Class="admin-shell">
        <MudPaper Elevation="0" Outlined="true" Class="admin-subnav pa-2" Style="min-width: 250px;">
            <MudNavMenu>
                <MudNavGroup Title="@AdminLoc["Group_Access"]" Icon="@Icons.Material.Filled.People" Expanded="true">
                    <MudNavLink Href="admin/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">@AdminLoc["Tab_UserManagement"]</MudNavLink>
                    <MudNavLink Href="admin/collection-access" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FolderShared">@AdminLoc["Tab_CollectionAccess"]</MudNavLink>
                    <MudNavLink Href="admin/shares" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Share">@AdminLoc["Tab_ShareManagement"]</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="@AdminLoc["Group_Operations"]" Icon="@Icons.Material.Filled.Build" Expanded="true">
                    <MudNavLink Href="admin/migrations" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CloudUpload">@AdminLoc["Tab_Migrations"]</MudNavLink>
                    <MudNavLink Href="admin/trash" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Delete">@AdminLoc["Tab_Trash"]</MudNavLink>
                    <MudNavLink Href="admin/audit" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.History">@AdminLoc["Tab_AuditLog"]</MudNavLink>
                </MudNavGroup>
            </MudNavMenu>
        </MudPaper>

        <div class="admin-content flex-grow-1" style="min-width: 0;">
            <AdminBreadcrumbs />
            @Body
        </div>
    </MudStack>
</MudContainer>
