@using Microsoft.AspNetCore.Components.Authorization

@* AppAssembly is the host (it owns App.razor); every routable page lives in the
   AssetHub.Ui RCL, so that assembly is scanned via AdditionalAssemblies.

   NotFoundPage renders unknown routes inside a running circuit; a full page load
   of an unknown URL reaches the same page through the host's status-code
   re-execution. Never set the <NotFound> fragment as well — the router throws. *@
<Router AppAssembly="typeof(App).Assembly" AdditionalAssemblies="UiAssembly" NotFoundPage="typeof(AssetHub.Ui.Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <AccessDeniedContent />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    // Static so the router is not handed a freshly-allocated array on every render.
    private static readonly Assembly[] UiAssembly = [typeof(MainLayout).Assembly];
}
