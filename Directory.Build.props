<Project>
  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>true</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>true</GenerateAssemblyInformationalVersionAttribute>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <!--
    Fail the build on vulnerable NuGet packages so a CI-failing advisory is
    caught at `dotnet build` time, not after a push. NuGet audit covers direct
    + transitive deps (NuGetAuditMode=all, matching CI's include-transitive scan)
    and reports everything down to low. The gate itself is the warning/error
    promotion: HIGH (NU1903) and CRITICAL (NU1904) break the build; moderate
    (NU1902) and low (NU1901) stay visible-but-non-blocking. Severity->code map:
    NU1901 low / NU1902 moderate / NU1903 high / NU1904 critical.
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!--
    Lock the resolved package graph so builds are time-independent. The csproj
    files keep floating versions ("10.0.*") for easy intentional upgrades, but
    day-to-day restores replay packages.lock.json instead of re-resolving —
    without this, any fresh restore can pull newly-published floats and a new
    advisory database, making the build's outcome depend on the calendar
    (observed 2026-08-10: NU1605/NU1903/CS8602 from float movement mid-change).
    Update the locks deliberately: dotnet restore with the force-evaluate flag.
    CI should restore in locked mode to enforce the lock (follow-up: ci.yml).
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Override vulnerable transitive dependencies -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!--
    SonarAnalyzer.CSharp surfaces SonarCloud's rules at compile time so
    we catch S-prefixed issues during dev builds instead of after a
    push. PrivateAssets="all" keeps it out of the published packages.
  -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.4.0.108396">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
