@using MudBlazor
@using AssetHub.Application.Dtos
@using AssetHub.Ui.Resources
@using AssetHub.Ui.Services

@inject IAssetHubApiClient Api
@inject IUserFeedbackService Feedback
@inject IDialogService DialogService
@inject IStringLocalizer<CommonResource> CommonLoc
@inject IStringLocalizer<AdminResource> AdminLoc
@inject IStringLocalizer<TrashAdminResource> TrashLoc

@if (_loading && _items == null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_items == null || _items.Count == 0)
{
    <EmptyState Title="@TrashLoc["Trash_Empty_Title"]"
                Description="@TrashLoc["Trash_Empty_Desc"]"
                Icon="@Icons.Material.Filled.Delete" />
}
else
{
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @TrashLoc["Trash_Desc"]
            </MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.DeleteForever"
                       OnClick="EmptyAsync">
                @TrashLoc["Trash_Btn_Empty"]
            </MudButton>
        </MudStack>

        <MudTable Items="@_items" Hover="true" Dense="true" Striped="true" Loading="@_loading"
                  FixedHeader="true">
            <HeaderContent>
                <MudTh>@TrashLoc["Trash_Header_Title"]</MudTh>
                <MudTh>@TrashLoc["Trash_Header_Type"]</MudTh>
                <MudTh>@TrashLoc["Trash_Header_DeletedAt"]</MudTh>
                <MudTh>@TrashLoc["Trash_Header_DeletedBy"]</MudTh>
                <MudTh>@TrashLoc["Trash_Header_Expires"]</MudTh>
                <MudTh Style="width: 200px;"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@TrashLoc["Trash_Header_Title"]">
                    <MudText Typo="Typo.body2" Class="font-semibold">@context.Title</MudText>
                </MudTd>
                <MudTd DataLabel="@TrashLoc["Trash_Header_Type"]">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.AssetType</MudChip>
                </MudTd>
                <MudTd DataLabel="@TrashLoc["Trash_Header_DeletedAt"]">
                    <MudTooltip Text="@context.DeletedAt.ToLocalTime().ToString("F")">
                        <MudText Typo="Typo.body2">@context.DeletedAt.ToLocalTime().ToString("d")</MudText>
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="@TrashLoc["Trash_Header_DeletedBy"]">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.DeletedByUserId ?? "—")</MudText>
                </MudTd>
                <MudTd DataLabel="@TrashLoc["Trash_Header_Expires"]">
                    <MudText Typo="Typo.body2" Color="@ExpiresColor(context.ExpiresAt)">@FormatExpires(context.ExpiresAt)</MudText>
                </MudTd>
                <MudTd>
                    <MudStack Row="true" Spacing="1">
                        <MudTooltip Text="@TrashLoc["Trash_Btn_Restore"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Restore" Size="Size.Small" Color="Color.Primary"
                                           aria-label="@TrashLoc["Trash_Btn_Restore"]"
                                           OnClick="@(() => RestoreAsync(context))" />
                        </MudTooltip>
                        <MudTooltip Text="@TrashLoc["Trash_Btn_Purge"]">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small" Color="Color.Error"
                                           aria-label="@TrashLoc["Trash_Btn_Purge"]"
                                           OnClick="@(() => PurgeAsync(context))" />
                        </MudTooltip>
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudStack>
}

@code {
    private List<TrashedAssetDto>? _items;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var (ok, response) = await Feedback.ExecuteWithFeedbackAsync(
            () => Api.GetTrashAsync(), "load trash");
        _items = ok && response is not null ? response.Items : new();
        _loading = false;
    }

    private async Task RestoreAsync(TrashedAssetDto item)
    {
        // Optimistic remove from the trash list — the asset is no longer in trash after restore.
        var removed = item;
        _items!.Remove(item);
        StateHasChanged();

        var ok = await Feedback.ExecuteWithFeedbackAsync(
            () => Api.RestoreFromTrashAsync(item.Id), "restore from trash",
            successMessage: string.Format(TrashLoc["Trash_Restored"].Value, item.Title));
        if (!ok)
        {
            _items!.Add(removed);
            StateHasChanged();
        }
    }

    private async Task PurgeAsync(TrashedAssetDto item)
    {
        var confirmed = await DialogService.ShowConfirmAsync(
            TrashLoc["Trash_Confirm_Purge_Title"].Value,
            string.Format(TrashLoc["Trash_Confirm_Purge_Text"].Value, item.Title),
            TrashLoc["Trash_Btn_Purge"].Value,
            iconColor: Color.Error,
            confirmColor: Color.Error);
        if (!confirmed) return;

        var removed = item;
        _items!.Remove(item);
        StateHasChanged();

        var ok = await Feedback.ExecuteWithFeedbackAsync(
            () => Api.PurgeFromTrashAsync(item.Id), "purge from trash",
            successMessage: string.Format(TrashLoc["Trash_Purged"].Value, item.Title));
        if (!ok)
        {
            _items!.Add(removed);
            StateHasChanged();
        }
    }

    private async Task EmptyAsync()
    {
        if (_items is null || _items.Count == 0) return;

        var confirmed = await DialogService.ShowConfirmAsync(
            TrashLoc["Trash_Confirm_Empty_Title"].Value,
            string.Format(TrashLoc["Trash_Confirm_Empty_Text"].Value, _items.Count),
            TrashLoc["Trash_Btn_Empty"].Value,
            iconColor: Color.Error,
            confirmColor: Color.Error);
        if (!confirmed) return;

        var (ok, response) = await Feedback.ExecuteWithFeedbackAsync(
            () => Api.EmptyTrashAsync(), "empty trash");
        if (ok && response is not null)
        {
            Feedback.ShowSuccess(string.Format(TrashLoc["Trash_Emptied"].Value, response.Purged, response.Failed));
            await LoadAsync();
        }
    }

    // Colour-code the expires column so admins can see what's closest to auto-purge.
    private static Color ExpiresColor(DateTime expiresAt)
    {
        var hours = (expiresAt - DateTime.UtcNow).TotalHours;
        if (hours < 0) return Color.Error;
        if (hours < 24) return Color.Warning;
        return Color.Default;
    }

    private string FormatExpires(DateTime expiresAt)
    {
        var delta = expiresAt - DateTime.UtcNow;
        if (delta.TotalHours < 0) return TrashLoc["Trash_ExpiresRelative_Overdue"].Value;
        if (delta.TotalHours < 24) return TrashLoc["Trash_ExpiresRelative_Today"].Value;
        if (delta.TotalHours < 48) return TrashLoc["Trash_ExpiresRelative_Tomorrow"].Value;
        return string.Format(TrashLoc["Trash_ExpiresRelative_InDays"].Value, (int)Math.Ceiling(delta.TotalDays));
    }
}
