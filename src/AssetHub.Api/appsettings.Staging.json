{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "MassTransit": "Warning"
      }
    }
  },
  "MinIO": {
    "UseSSL": true
  },
  "Email": {
    "FromName": "AssetHub (Staging)",
    "Enabled": true
  },
  "ClamAV": {
    "Enabled": true
  },
  "Database": {
    "AutoMigrate": false
  },
  "OpenTelemetry": {
    "Enabled": true,
    "OtlpEndpoint": "http://aspire-dashboard:18889",
    "SamplingRatio": 0.5,
    "RecordExceptions": true,
    "StripQueryStrings": true
  }
}
