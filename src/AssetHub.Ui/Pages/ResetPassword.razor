@page "/reset-password"
@using Microsoft.AspNetCore.Authorization

@attribute [AllowAnonymous]

@inject IStringLocalizer<CommonResource> CommonLoc

<PageTitle>@CommonLoc["ResetPassword_Title"] - @CommonLoc["AppName"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center login-container">
    <MudPaper Class="pa-8 login-card" Elevation="4">
        <MudStack Spacing="4">
            <MudText Typo="Typo.h5">@CommonLoc["ResetPassword_Title"]</MudText>

            @if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Token))
            {
                <MudAlert Severity="Severity.Error" Dense="true" role="alert">
                    @CommonLoc["ResetPassword_LinkInvalid"]
                </MudAlert>
            }
            else
            {
                @if (!string.IsNullOrEmpty(Error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" role="alert">
                        @(Error == "policy"
                            ? CommonLoc["ResetPassword_Error_Policy"]
                            : CommonLoc["ResetPassword_LinkInvalid"])
                    </MudAlert>
                }

                @* Plain form POST — establishing the new password happens outside the
                   Blazor circuit, same reason as the sign-in form. *@
                <form method="post" action="/auth/reset-password">
                    <input type="hidden" name="userId" value="@UserId" />
                    <input type="hidden" name="token" value="@Token" />

                    <div class="mb-4">
                        <label for="newPassword" class="mud-input-label">@CommonLoc["ResetPassword_NewPassword"]</label>
                        <input id="newPassword" name="newPassword" type="password" required autofocus
                               autocomplete="new-password" class="mud-input-slot login-input" />
                    </div>

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true">
                        @CommonLoc["ResetPassword_Submit"]
                    </MudButton>
                </form>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }
}
